# examples/auth-cms — environment template. Copy to .env and fill in.
# All values here are non-secret PLACEHOLDERS; never commit real credentials.
#
# AUTH_RUNTIME_MODE=development|production is read from the PROCESS environment
# only, never from this file (LoadEnvForMode refuses a .env that assigns it, even
# empty). Development: AUTH_RUNTIME_MODE=development go run ./cmd/server (the rest
# of .env still loads). Production never opens .env: set every variable through
# systemd Environment=/EnvironmentFile=, docker --env-file, or platform secrets.

# --- HTTP server ---
HOST=localhost                 # bind host
PORT=8082                      # bind port
TRUSTED_PROXY_COUNT=0          # proxy hops in front of this host; 0 trusts only the peer address
PUBLIC_BASE_URL=               # e.g. https://app.example.com (https in production); empty => http://HOST:PORT

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=text                # text | json  (the console mailer logs codes/tokens here)
LOG_OUTPUT=STDERR              # STDERR | STDOUT

# --- JWT access + refresh sessions (auth-jwt plan) ---------------------------
# The access credential is now a REQUIRED signed JWT (the signer can no longer be
# nil). AUTH_JWT_SECRET signs it and the session anchor's refresh rotation. It is
# HEX decoding to at least 32 bytes (openssl rand -hex 32). If UNSET in development,
# the host generates an EPHEMERAL RANDOM key at boot (production refuses to boot) —
# a DEV / SINGLE-INSTANCE convenience: access JWTs do NOT survive a
# restart (a fresh key can't verify an old token), though API clients recover via
# POST /auth/refresh (refresh tokens are DB/store-backed). A MULTI-INSTANCE
# deployment behind a load balancer MUST set a shared AUTH_JWT_SECRET across every
# instance — per-instance ephemeral keys cannot cross-verify and auth flaps on
# every request. A committed constant is a leak, so this host never ships one.
AUTH_JWT_SECRET=               # hex, >=32 bytes; unset => ephemeral dev key (production refuses)
#
# AUTH_ACCESS_TOKEN_TTL is the access-JWT lifetime (a Go duration); empty => 15m.
# Keep it short — it bounds the revocation-asymmetry window on stateless
# RequireUser routes (RequireLiveSession routes revoke immediately). A short value
# (e.g. AUTH_ACCESS_TOKEN_TTL=1s) drives the expired-access-JWT proof legs.
AUTH_ACCESS_TOKEN_TTL=         # e.g. 15m, 1s; empty => 15m
#
# AUTH_REFRESH_TTL is the fixed refresh-token / session horizon (a Go duration);
# empty => 168h (7d). It is set at mint and NEVER extended by rotation (a stolen
# refresh token therefore cannot outlive it).
AUTH_REFRESH_TTL=              # e.g. 168h; empty => 7d
#
# AUTH_IDLE_TIMEOUT ends a first-party session nobody has refreshed for this long
# (a Go duration; inactivity = no refresh rotation within it): the next refresh is
# the generic 401, the row is deleted and session_idle_expired is recorded. Empty
# => off. It must exceed AUTH_ACCESS_TOKEN_TTL (boot refuses otherwise); under
# twice it WARNs. A client refreshing on a timer is never idle. Delegated OAuth
# connections are out of scope. On a SQL store it needs migration 0029 applied
# first (boot refuses naming it); authmem needs nothing.
# AUTH_IDLE_TIMEOUT=3m

# --- Provider-token encryption (design §3) -----------------------------------
# AUTH_TOKEN_ENCRYPTER_KEY, when set, must be hex decoding to EXACTLY 32 bytes and enables
# AES-256-GCM encryption of provider access/refresh tokens at rest. Unset =>
# provider tokens are NOT persisted (login and linking still work) — a safe,
# documented degradation. No real key ever lands in this file.
AUTH_TOKEN_ENCRYPTER_KEY=      # hex, exactly 32 bytes (64 hex chars); unset => tokens not stored, every mode

# --- Auth v3 secrets: FIVE DISTINCT keys (design §3.3/§4.4/§6.1.1) ------------
# Each auth key has a SEPARATE purpose and MUST be a distinct value — one key is
# never reused across roles (a compromise of one must not compromise the others),
# and no key material is ever printed (only a WARN when a key is ephemeral). Every
# key is HEX (one encoding: openssl rand -hex 32). Every key below, when UNSET in
# development, falls back to an EPHEMERAL random per-boot key: a DEV /
# SINGLE-INSTANCE convenience only (values do not survive a restart, and a
# MULTI-INSTANCE deployment MUST set + share every key). Production refuses to boot
# with any of them unset, naming each. Distinct from AUTH_JWT_SECRET
# (session/JWT signing) and AUTH_TOKEN_ENCRYPTER_KEY (provider tokens) above.
#
# AUTH_CHALLENGE_PEPPER protects short OTP codes with an in-process HMAC key ring
# (design §3.3, §11). Hex, >= 32 bytes. Its active key ID stamps each issued
# challenge so an overlapping rotation still verifies an unexpired code.
AUTH_CHALLENGE_PEPPER=         # hex, >=32 bytes; unset => ephemeral dev pepper (production refuses)
#
# AUTH_IDENTIFIER_KEY derives PII-free rate-limit / outbox idempotency digests with a
# stable HMAC (design §4.4). Hex, >= 32 bytes. Deliberately separate from the pepper,
# JWT, and encryption keys; production requires it shared across instances.
AUTH_IDENTIFIER_KEY=          # hex, >=32 bytes; unset => ephemeral dev key (production refuses)
#
# AUTH_DELIVERY_ENCRYPTER_KEY seals the durable delivery-outbox payload envelope with
# AES-256-GCM (design §6.1.1) — pending jobs briefly carry the rendered secret +
# destination. Hex, EXACTLY 32 bytes. An ephemeral key strands any in-flight job on restart.
AUTH_DELIVERY_ENCRYPTER_KEY=  # hex, exactly 32 bytes (64 hex chars); unset => ephemeral dev key (production refuses)
#
# AUTH_DELIVERY_MODE selects the outbound-delivery composition (AV3D-5.3) — the
# authentication pocket's own key, read through its Config tags. Default (unset or
# empty) is the generic-jobs mode this host pre-seeds. On THIS proof host jobs mode is
# backed by an IN-MEMORY fenced queue (jobsmem), so it is NOT durable here: accepted
# work is LOST on restart and there is NO cross-instance coordination (a real host makes
# it durable by swapping in a pgx/turso FencedQueue store). "in_process" selects the
# small-deployment EPHEMERAL bounded pool with the same crash-loss/no-coordination
# posture, announced by a LOUD startup WARN. Any other value is a LOUD construction
# failure at boot, never a silent fallback.
AUTH_DELIVERY_MODE=           # empty|jobs => jobs wiring (in-memory here); in_process => ephemeral bounded pool

# Delivery terminal-purge scheduler (jobs mode only, IX-10): a host-owned loop removes at
# most DELIVERY_PURGE_BATCH terminal delivery rows older than DELIVERY_PURGE_RETENTION each
# DELIVERY_PURGE_INTERVAL, so durable rows + encrypted metadata do not grow without bound. A
# no-op on this in-memory demo (nothing survives restart); it exercises the real host wiring.
DELIVERY_PURGE_INTERVAL=      # Go duration; unset => 1h
DELIVERY_PURGE_RETENTION=     # Go duration; unset => 24h (terminal-row min age to purge)
DELIVERY_PURGE_BATCH=         # int; unset => 500 (max rows removed per pass)

# Inquiry retention (SOC 2 S3, every delivery mode): a host-owned loop removes at most
# INQUIRY_PURGE_BATCH cms contact-form inquiries (a third party's name, email, message) older
# than INQUIRY_PURGE_RETENTION each INQUIRY_PURGE_INTERVAL, through the eraser this host wires
# as cms.Repositories.InquiryMaintenance; each pass logs step=inquiries count=<n>.
INQUIRY_PURGE_INTERVAL=       # Go duration; unset => 1h
INQUIRY_PURGE_RETENTION=      # Go duration; unset => 2160h (90 days; inquiry min age to purge)
INQUIRY_PURGE_BATCH=          # int; unset => 500 (max inquiries removed per pass)

# Retention runner (SOC 2 S3): the retention host pocket ticks the authentication
# maintenance pass at start and every MAINTENANCE_INTERVAL — expired sessions, OAuth
# states, grants, contact changes and challenges; terminal and expired invitations;
# the OAuth2 prune; and, once a day, the security-event rail past 400 days — then the
# authorization operation expiry (step=operations, at most 500 a tick). Each step
# logs one line (step, count, skipped, error_kind). INVITATION_RETENTION is how long a
# terminal invitation (and a pending one past its expiry) is kept; a short value makes
# the invitation purge observable in a run-and-look.
MAINTENANCE_INTERVAL=         # Go duration; unset => 1h
INVITATION_RETENTION=         # Go duration; unset => 2160h (90 days)

# --- Key rings and rotation (SOC 2 S4d part 3) -----------------------------
# The JWT, pepper, delivery and provider-token keys each take a RING form beside
# the single variable above: "id:hex,id:hex" (openssl rand -hex 32 per key) and
# the id that signs or seals. Ids are lower-case, e.g. k1, k2. Boot logs one
# "auth: keys" line naming each role's kind, active id, ids and legacy read —
# never a key. The "Rotate a key" runbook (operations-runbooks) is the procedure.
#
# JWT: a ring stamps each token's header with its key id (kid). Keep
# AUTH_JWT_SECRET set beside the ring and it joins as id "legacy", verifying
# tokens with no kid; while AUTH_JWT_ACTIVE_KEY=legacy the ring writes no kid
# (phase (a) of a rolling rotation). Each key >= 32 bytes.
# AUTH_JWT_KEYS=               # e.g. k1:<hex>,k2:<hex>
# AUTH_JWT_ACTIVE_KEY=         # e.g. k2, or legacy during phase (a)
#
# Challenge pepper: challenge rows and recovery codes STORE the key id, so the
# ring names its ids itself and refuses AUTH_CHALLENGE_PEPPER beside it. This
# host's single pepper uses id "dev": the first entry keeps that id and value.
# Each key >= 32 bytes.
# AUTH_CHALLENGE_PEPPERS=      # e.g. dev:<current hex>,p2:<new hex>
# AUTH_CHALLENGE_ACTIVE_PEPPER= # e.g. p2
#
# Delivery envelope: AUTH_DELIVERY_ENCRYPTER_KEY kept beside the ring joins as
# "legacy" and opens envelopes sealed before the ring. Drain the queue before
# dropping it. Each key exactly 32 bytes.
# AUTH_DELIVERY_ENCRYPTER_KEYS=       # e.g. d1:<hex>
# AUTH_DELIVERY_ENCRYPTER_ACTIVE_KEY= # e.g. d1, or legacy during phase (a)
#
# Provider tokens: AUTH_TOKEN_ENCRYPTER_KEY kept beside the ring joins as
# "legacy" and still opens stored rows sealed before the ring. A stored row is
# rewritten only by unlink + relink or a host sweep, so keep legacy until the
# runbook's count query returns zero. Each key exactly 32 bytes.
# AUTH_TOKEN_ENCRYPTER_KEYS=          # e.g. t1:<hex>
# AUTH_TOKEN_ENCRYPTER_ACTIVE_KEY=    # e.g. t1, or legacy during phase (a)
#
# First-party token iss/aud: set, every access token carries them and a token
# without them (or with other values) is refused; each client refreshes once at
# enablement. Must differ from the OAuth2 issuer and resources. Unset => none.
# AUTH_TOKEN_ISSUER=           # e.g. https://auth.example.com
# AUTH_TOKEN_AUDIENCE=         # e.g. app

# --- Auth v3 HTML surface + passwordless + magic links (design §4.2/§6.4/§9) --
# This host wires the bundled default templ Views (auth.Config.Views), so normal HTML
# GET pages + form handling mount alongside the unchanged JSON API. The knobs below
# tune the browser-safe surface; all have safe development defaults.
#
# AUTH_PUBLIC_BASE_URL is the absolute base URL magic links are built from (design
# §6.4): the framework appends "#token=<token>" to it, so it must point at the page that
# hosts the fragment-reading landing script — here the bundled landing GET at
# /auth/magic. Request Host/forwarded headers NEVER participate. Empty => this host's own
# http://HOST:PORT/auth/magic. Production RuntimeMode REQUIRES an https:// value.
AUTH_PUBLIC_BASE_URL=          # e.g. https://app.example.com/auth/magic; empty => http://HOST:PORT/auth/magic
#
# AUTH_OAUTH_LINK_URL is the absolute SPA landing URL the anti-takeover OAuth
# pending-link email links to, BEFORE "#token=<token>" is appended (oauth-pending-link
# plan D1). It is SEPARATE from AUTH_PUBLIC_BASE_URL: that route POSTs magic-link
# redeem, this one POSTs verify-link. The token rides the URL FRAGMENT, so the landing
# page reads it client-side and never sends it to the server on the GET. No fragment in
# the value (the token owns it); production RuntimeMode REQUIRES an https:// value.
# EMPTY (this demo's default) => the pending-link mail keeps its bare-token line and one
# startup WARN names this variable. This demo DOES serve a landing page: with Config.Views
# wired and a provider configured, the pocket mounts the bundled public GET
# /auth/oauth/link, so http://HOST:PORT/auth/oauth/link is a working value here.
AUTH_OAUTH_LINK_URL=           # e.g. http://localhost:8080/auth/oauth/link; empty => bare-token email fallback
#
# AUTH_INVITATION_URL is the absolute landing URL an invitation links to when the
# inviter named no allowlisted redirect, BEFORE "#token=<token>" is appended (SOC 2
# S7). The token rides the URL FRAGMENT, so a landing page reads location.hash,
# scrubs it, and POSTs /auth/invitations/accept. No fragment in the value;
# production REQUIRES it (https) whenever invitations are wired. Empty => this
# host's own http://HOST:PORT/ (it serves no invitation landing page).
AUTH_INVITATION_URL=           # e.g. https://app.example.com/invite; empty => http://HOST:PORT/
#
# AUTH_MEMBER_ADDED_URL is where the "you were added" notice links when the inviter
# named no allowlisted redirect. The member already has access, so it never uses the
# token-less invitation landing. Empty => the root of AUTH_INVITATION_URL's origin.
AUTH_MEMBER_ADDED_URL=         # e.g. https://app.example.com/projects; empty => origin root
#
# AUTH_INVITATION_TOKEN_IN_QUERY=1 restores the old "?token=" invitation link for
# ONE release while a landing page moves to the fragment; production logs a
# posture_waiver=InvitationTokenInQuery WARN. The next authentication minor removes it.
AUTH_INVITATION_TOKEN_IN_QUERY=  # 1 => ?token= (one-release hatch); empty => #token=
#
# AUTH_ALLOWED_ORIGINS is the comma-separated exact-match Origin allowlist the
# browser-safe mutation gate validates cookie-authenticated sensitive mutations and
# HTML form posts against (design §9.1). Empty => this host's own origin. A "*" entry
# never authorizes a credentialed cross-origin mutation.
AUTH_ALLOWED_ORIGINS=          # e.g. https://app.example.com; empty => http://HOST:PORT
#
# AUTH_PASSWORDLESS is the comma-separated set of identifier kinds passwordless login
# is enabled for (design §4.2); allowed kinds are email and phone. Empty => both
# (email magic link + OTP, phone OTP via the console notifier). Set to a subset to
# narrow it; each listed kind needs a wired delivery channel or construction fails.
AUTH_PASSWORDLESS=             # e.g. email,phone; empty => email,phone

# --- Debug audit route (plan-cut amendment, SRE) -----------------------------
# AUTH_DEBUG=1 registers GET /debug/security-events. It is DEFAULT-OFF because it
# dumps IP/UA/emails and this host is public; it is DEVELOPMENT ONLY (any other mode
# refuses to boot) and ADDITIONALLY gated on a live session plus the platform-admin
# permission. Unset => the route is not registered (404).
AUTH_DEBUG=                    # 1 enables GET /debug/security-events (development, platform admin)

# --- Demo platform admin (owner drill, SOC 2 S7) ----------------------------
# AUTH_DEMO_ADMIN_EMAIL (DEVELOPMENT ONLY; a non-empty value refuses boot in any
# other mode) grants platform:main#admin, once and audited, to the account that
# verifies this address as its sign-in email. Unset => no account is a platform admin.
AUTH_DEMO_ADMIN_EMAIL=         # e.g. owner@example.com; development only

# --- Session and machine governance (SOC 2 S4d) -----------------------------
# AUTH_REGISTRATION selects who may create an account, on every path (register,
# passwordless provision-on-redeem, OAuth first sign-in): open (default),
# invitation_only (an address with a pending invitation) or closed (the register
# routes answer 404). Any other value refuses boot.
AUTH_REGISTRATION=             # open | invitation_only | closed; empty => open
#
# AUTH_GLOBAL_SESSION_REVOCATION_ROUTE mounts POST /auth/admin/sessions/revoke-all
# (platform admin, access token only, MFA, once a minute). It ends EVERY session.
AUTH_GLOBAL_SESSION_REVOCATION_ROUTE=  # false unmounts it; empty => mounted
#
# AUTH_SERVICE_ACCOUNT_STATUS=1 turns on POST /auth/service-accounts/{id}/disable
# and /enable: a disable revokes the account's keys and refuses new mints.
AUTH_SERVICE_ACCOUNT_STATUS=   # 1 enables disable/enable; empty => off
#
# AUTH_API_KEY_MAX_TTL bounds a minted API key's life (a Go duration); an omitted
# expires_at is filled with now + it. Empty => unlimited in development, 8760h
# (365 days) in production; 2160h (90 days) is recommended.
AUTH_API_KEY_MAX_TTL=          # e.g. 2160h; empty => unlimited (development)
#
# AUTH_DEMO_API_KEYS_EXEMPT=1 (development only) lets API keys pass the MFA gates
# again, to show the MFAConfig.APIKeysExempt hatch; a real host sets it in code.
AUTH_DEMO_API_KEYS_EXEMPT=     # 1 => keys pass RequireMFA() and the admin gates
#
# AUTH_DEMO_MFA_REQUIRED=all (development only; any other mode refuses to boot)
# turns on native MFAConfig.Required all beside the passkeys and TOTP wired here:
# a session without a second factor uses the app at AAL1 for the enrollment
# grace, then only the enrollment surface answers it (/demo/floor and
# /demo/floor/page are the probes). A real host sets these in code.
AUTH_DEMO_MFA_REQUIRED=        # all; empty => the admins default
AUTH_DEMO_MFA_ENROLLMENT_GRACE= # e.g. 3m for a drill; empty => 168h (7 days); at most 720h
AUTH_DEMO_MFA_ENROLLMENT_START= # RFC 3339; empty => boot time

# --- External identity hybrid demo (external-identity-providers task-7) -----
# AUTH_EXTERNAL_DEMO=1 (development only; any other mode refuses to boot) wires a
# dev OIDC issuer served by this process beside the native credentials, mounts
# POST /dev/token and GET /demo/external/{hybrid,mfa,only}, and seeds one API key
# whose plaintext is logged ONCE at boot.
AUTH_EXTERNAL_DEMO=            # 1 enables the external identity hybrid demo

# --- OAuth2 server / MCP connection demo --------------------------------------
# AUTH_OAUTH2_DEMO=1 (development only; any other mode refuses to boot) wires the
# OAuth2 authorization server with a local MCP demo client at /oauth-demo. It also
# sets OAuth2Config.DelegatedAssurance: a grant carries the approving session's
# aal/methods (the memory store needs no migration; a SQL host applies 0030
# first), introspection reports them, and GET /demo/oauth2/mfa admits an MCP
# token only at AAL2 (approve from a session that stepped up).
AUTH_OAUTH2_DEMO=              # 1 enables the OAuth2 server and MCP demo

# --- OAuth provider (design §3) ----------------------------------------------
# This proof host wires a HOST-LOCAL FAKE provider (no vendor, no network), so
# these are unused here — they are placeholders for a real host swapping in
# integrations/oauth/google or integrations/oauth/github via auth.Config.Providers.
# Never commit real client secrets.
OAUTH_CLIENT_ID=               # a real provider's client id (unused by the fake provider)
OAUTH_CLIENT_SECRET=           # a real provider's client secret (unused by the fake provider)
