# examples/external-identity — environment template. Copy to .env and fill in.
# All values here are non-secret PLACEHOLDERS; this host has no secrets.

# --- HTTP server ---
HOST=localhost                 # bind host
PORT=8080                      # bind port; the dev issuer lives at http://HOST:PORT/dev/issuer
PUBLIC_BASE_URL=               # set when the host is reached through another origin (https in production)
TRUSTED_PROXY_COUNT=0          # proxy hops in front of this host; 0 trusts only the peer address

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=text                # text | json
LOG_OUTPUT=STDERR              # STDERR | STDOUT

# --- Runtime mode ---
# AUTH_RUNTIME_MODE=development|production is read from the PROCESS environment
# only, never from this file (LoadEnvForMode refuses .env naming it): run with
# AUTH_RUNTIME_MODE=development go run ./cmd/server. development is the ONLY
# mode this host boots in: the dev issuer refuses any other, so production
# fails at construction until a real provider replaces it.

# --- Session lifetime (SOC 2 S4d part 2) ---
# ExternalProvider.MaxAuthenticationAge has no env key here: it is a Go field,
# left zero (unbounded) in cmd/server/main.go. A real provider sets it, e.g.
# 12h, to deny a token whose holder signed in at the provider longer ago
# (auth_time, else iat; +60s leeway). This host mints no native sessions, so
# AUTH_IDLE_TIMEOUT does not apply.
