# examples/external-identity — environment template. Copy to .env and fill in.
# All values here are non-secret PLACEHOLDERS; this host has no secrets.

# --- HTTP server ---
HOST=localhost                 # bind host
PORT=8080                      # bind port; the dev issuer lives at http://HOST:PORT/dev/issuer
PUBLIC_BASE_URL=               # set when the host is reached through another origin

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=text                # text | json
LOG_OUTPUT=STDERR              # STDERR | STDOUT

# --- Runtime mode ---
# development is the ONLY mode this host boots in: the dev issuer refuses any
# other, so production fails at construction until a real provider replaces it.
AUTH_RUNTIME_MODE=development
