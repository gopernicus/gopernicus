# examples/production-baseline — environment template. Copy to .env and fill in.
# All values here are non-secret placeholders; never commit real credentials.
# Production never opens .env: set every variable below in the process
# environment there.

# --- Runtime mode ---
# APP_RUNTIME_MODE=development|production — read from the process environment only, never from this file (LoadEnvForMode refuses any assignment of the key in .env); development: make run and make migrate export APP_RUNTIME_MODE=development; production: systemd Environment=/EnvironmentFile=, docker --env-file, or platform secrets

# --- HTTP server ---
HOST=localhost                 # bind host
PORT=8080                      # bind port; the dev issuer lives at http://HOST:PORT/dev/issuer
SHUTDOWN_TIMEOUT=10s           # graceful-shutdown budget
TRUSTED_PROXY_COUNT=0          # proxy hops in front of this host; 0 trusts only the peer address
PUBLIC_BASE_URL=               # https://… in production, where it is required; the one origin cookie mutations may come from

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=text                # text | json
LOG_OUTPUT=STDERR              # STDERR | STDOUT
# LOG_REDACT_KEYS=             # extra attribute keys to redact, comma-separated; adds to the defaults (password, token, api_key, ...), e.g. client_ip,user_agent

# --- Authentication keys ---
# Hex, each a distinct value: openssl rand -hex 32. Development mints an
# ephemeral key for each unset one (a WARN; access tokens do not survive a
# restart); production refuses to boot with either unset, naming both.
# The signing key is a key ring: "id:hex,id:hex" and the id that signs. Each
# token's header carries the signing id (kid), so a second id can be added and
# activated with no 401 wave (the "Rotate a key" runbook). Boot logs
# auth: keys jwt_signer=ring jwt_active_key_id=k1 jwt_key_ids=k1 jwt_legacy=no.
AUTH_JWT_KEYS=                 # e.g. k1:<hex>; each key >= 32 bytes; signs access tokens
AUTH_JWT_ACTIVE_KEY=           # e.g. k1; must name an id in AUTH_JWT_KEYS
# AUTH_JWT_SECRET=             # the pre-ring single key; set beside the ring ONLY during a migration to the ring:
#                              # it joins as id "legacy" (verifies tokens with no kid) and production WARNs
#                              # posture_warning=legacy_key_read_enabled until it is unset again
AUTH_IDENTIFIER_KEY=           # hex, >= 32 bytes; keys the PII-free rate-limit digests (rotate freely: budgets reset once)

# --- External identity provider (OIDC) ---
# Unset IDP_ISSUER serves the development issuer from this process; it refuses
# every mode but development, so production needs a real provider here.
IDP_ISSUER=                    # e.g. https://tenant.example.com/ (https in production)
IDP_AUDIENCE=                  # the aud your API's tokens carry
IDP_JWKS_URL=                  # the provider's key set; empty runs OIDC discovery at boot

# --- Datastore (PostgreSQL / pgx) ---
# PostgreSQL 18 or later: the migrator refuses an older server (pgxdb v0.17.0).
# Set DB_URL for a full DSN, or the split fields below (one or the other).
# postgres://user:pass@host:5432/db?sslmode=verify-full&sslrootcert=system
DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres               # two roles (README, "Two roles"): the owner for make migrate and make bootstrap; the server connects as the runtime role, baseline_app
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=verify-full
# DB_SSLMODE=disable  # local docker only — refused in production
# Statement and lock timeouts: server process only — the migrator zeroes them.
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s

# --- Retention (README, "Retention") ---
# The security-event archive: the maintenance pass writes each rail chunk older
# than 400 days here, reads it back, then purges it. Required in production;
# durable, backed up and shared across replicas (a disk sink is per instance:
# run one runner, or use integrations/filestorage/gcs or s3); holds IP/UA
# (PII) — restrict access; not erased by "Erase a person". Unset in
# development purges unarchived (archive_sink=none).
AUDIT_ARCHIVE_DIR=             # e.g. /var/lib/baseline/archive; ./archive locally

# --- Session and machine governance (SOC 2 S4d) ---
# AUTH_GLOBAL_SESSION_REVOCATION_ROUTE mounts POST /auth/admin/sessions/revoke-all
# (global admin, access or external token at AAL2, once a minute per actor). It
# ends EVERY session; the provider's own sessions survive it.
AUTH_GLOBAL_SESSION_REVOCATION_ROUTE=  # true mounts it; empty => unmounted (opt-in)
# The pocket's other S4d keys, NOT read by this host:
# AUTH_REGISTRATION=           # open | invitation_only | closed; this host provisions on first IdP sign-in with no invitations, so only open boots
# AUTH_SERVICE_ACCOUNT_STATUS= # 1 enables service-account disable/enable (needs migration 0027); this host wires no machine identity
# AUTH_API_KEY_MAX_TTL=        # a Go duration; empty => 8760h (365 days) in production, 2160h (90 days) recommended; no machine identity here

# --- Session lifetime (SOC 2 S4d part 2) ---
# IDP_MAX_AUTHENTICATION_AGE bounds how long ago a provider token's holder signed
# in at the provider (its auth_time, else iat; +60s leeway), checked on every
# request: an older token is 401 and records external_subject_denied
# reason=authentication_age_exceeded. It caps the provider's own session, which a
# local revoke does not end. 0 turns it off (production then WARNs
# external_authentication_age=unbounded); a negative value refuses boot.
IDP_MAX_AUTHENTICATION_AGE=12h # a Go duration; empty => 12h

# --- Asserted authentication time (SOC 2 S4d part 4) ---
# IDP_REQUIRE_AUTHENTICATION_TIME makes the bound above a sign-in bound: a token
# without auth_time is 401 and records ONE external_subject_denied
# reason=authenticated_at_unasserted per token, instead of being aged by its iat
# (which exp already bounds). The dev issuer and Firebase always send auth_time;
# a Google ID token does not unless the sign-in requests it (max_age / prompt),
# so leave this off for such an issuer. true with IDP_MAX_AUTHENTICATION_AGE=0
# refuses boot. The provider lifetime boot line says
# authentication_time=asserted_required|any.
IDP_REQUIRE_AUTHENTICATION_TIME=  # true | false; empty => false
# The pocket's other S4d part 4 key, NOT read by this host (it wires no OAuth2
# server): OAuth2Config.DelegatedAssurance, a literal a host with WithOAuth2 sets
# so delegated tokens carry the approving session's aal/methods. It needs
# migration 0036 here (pgx 0030) and every process that verifies delegated
# tokens on authentication >= v0.37.0 before it is set.
# The pocket's other S4d part 2 keys, NOT read by this host (external sign-in
# only: it mints no native sessions, so there is nothing to refresh or idle out):
# AUTH_IDLE_TIMEOUT=            # a Go duration; idle expiry of native sessions (needs migration 0035 here)
# AUTH_ACCESS_TOKEN_TTL=        # native access tokens only; above AUTH_REFRESH_TTL refuses boot
