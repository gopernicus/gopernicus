# examples/production-baseline — environment template. Copy to .env and fill in.
# All values here are non-secret placeholders; never commit real credentials.
# Production never opens .env: set every variable below in the process
# environment there.

# --- Runtime mode ---
# APP_RUNTIME_MODE=development|production — read from the process environment only, never from this file (LoadEnvForMode refuses any assignment of the key in .env); development: make run and make migrate export APP_RUNTIME_MODE=development; production: systemd Environment=/EnvironmentFile=, docker --env-file, or platform secrets

# --- HTTP server ---
HOST=localhost                 # bind host
PORT=8080                      # bind port; the dev issuer lives at http://HOST:PORT/dev/issuer
SHUTDOWN_TIMEOUT=10s           # graceful-shutdown budget
TRUSTED_PROXY_COUNT=0          # proxy hops in front of this host; 0 trusts only the peer address
PUBLIC_BASE_URL=               # https://… in production, where it is required; the one origin cookie mutations may come from

# --- Logging ---
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=text                # text | json
LOG_OUTPUT=STDERR              # STDERR | STDOUT

# --- Authentication keys ---
# Hex, each a distinct value: openssl rand -hex 32. Development mints an
# ephemeral key for each unset one (a WARN; access tokens do not survive a
# restart); production refuses to boot with either unset, naming both.
AUTH_JWT_SECRET=               # hex, >= 32 bytes; signs access tokens
AUTH_IDENTIFIER_KEY=           # hex, >= 32 bytes; keys the PII-free rate-limit digests

# --- External identity provider (OIDC) ---
# Unset IDP_ISSUER serves the development issuer from this process; it refuses
# every mode but development, so production needs a real provider here.
IDP_ISSUER=                    # e.g. https://tenant.example.com/ (https in production)
IDP_AUDIENCE=                  # the aud your API's tokens carry
IDP_JWKS_URL=                  # the provider's key set; empty runs OIDC discovery at boot

# --- Datastore (PostgreSQL / pgx) ---
# Set DB_URL for a full DSN, or the split fields below (one or the other).
# postgres://user:pass@host:5432/db?sslmode=verify-full&sslrootcert=system
DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres               # two roles (README, "Two roles"): the owner for make migrate and make bootstrap; the server connects as the runtime role, baseline_app
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=verify-full
# DB_SSLMODE=disable  # local docker only — refused in production
# Statement and lock timeouts: server process only — the migrator zeroes them.
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s

# --- Retention (README, "Retention") ---
# The security-event archive: the maintenance pass writes each rail chunk older
# than 400 days here, reads it back, then purges it. Required in production;
# durable, backed up and shared across replicas (a disk sink is per instance:
# run one runner, or use integrations/filestorage/gcs or s3); holds IP/UA
# (PII) — restrict access; not erased by "Erase a person". Unset in
# development purges unarchived (archive_sink=none).
AUDIT_ARCHIVE_DIR=             # e.g. /var/lib/baseline/archive; ./archive locally
