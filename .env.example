# Turso / libSQL remote database
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Firestore emulator — leave FIRESTORE_EMULATOR_HOST empty and the connector's
# emulator tests skip loudly. Start one with:
#   docker run --rm -d -p 8080:8080 \
#     gcr.io/google.com/cloudsdktool/google-cloud-cli:emulators \
#     gcloud emulators firestore start --host-port=0.0.0.0:8080 --project=gopernicus-test
# then set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080.
#
# LIVE Firestore credentials NEVER belong in a .env file: the live leg runs only
# in .github/workflows/live-stores.yml, from repo secrets, against a disposable
# run-owned database. There are deliberately no FIRESTORE_LIVE_* lines here.
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECT_ID=gopernicus-test

# HTTP server
HOST=localhost
PORT=8080
SHUTDOWN_TIMEOUT=10s

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=STDERR

# Media (disk-backed uploads)
MEDIA_DIR=media-data

# Email — leave SMTP_HOST empty to use the console sender (logs mail) in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=cms@localhost
CONTACT_EMAIL=ops@localhost
