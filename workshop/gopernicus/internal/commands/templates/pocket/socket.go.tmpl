// Package {{.Pocket}} assembles the {{.Pocket}} pocket over host-supplied stores.
// Use cases and their types live in logic/{{.Agg}}. The skeleton has no HTTP
// routes; add a public inbound/http adapter when transport is needed.
package {{.Pocket}}

import "{{.ModulePath}}/logic/{{.Agg}}"

// Repositories contains the outbound ports supplied by the host.
type Repositories struct {
    {{.ReposField}} {{.Agg}}.Storer
}

// NewService builds the public {{.Agg}} service using the host's repositories.
// Hosts may also construct {{.Agg}}.Service directly.
func NewService(repos Repositories, opts ...{{.Agg}}.Option) (*{{.Agg}}.Service, error) {
    return {{.Agg}}.NewService(repos.{{.ReposField}}, opts...)
}
