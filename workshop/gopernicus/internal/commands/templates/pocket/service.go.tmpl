package {{.Agg}}

import (
    "context"
    "fmt"
    "time"

    "github.com/gopernicus/gopernicus/sdk"
    "github.com/gopernicus/gopernicus/sdk/pkg/list"
)

var ErrStoreRequired = fmt.Errorf("{{.Pocket}}: {{.Agg}} store is required: %w", sdk.ErrInvalidInput)

// Option configures a service before it becomes available.
type Option func(*config)

type config struct {
    ids sdk.IDGenerator
}

// WithIDs selects the ID generator. Its zero value uses nanoid;
// sdk.NewIDGenerator(sdk.DatabaseID) defers generation to the store.
// Repeated options use the last supplied generator.
func WithIDs(ids sdk.IDGenerator) Option {
    return func(cfg *config) { cfg.ids = ids }
}

// Service implements {{.Agg}} use cases over the host's store.
type Service struct {
    store Storer
    ids sdk.IDGenerator
}

// NewService validates the store before making the service available.
func NewService(store Storer, opts ...Option) (*Service, error) {
    if store == nil {
        return nil, ErrStoreRequired
    }
    var cfg config
    for _, opt := range opts {
        if opt == nil {
            return nil, fmt.Errorf("{{.Pocket}}: nil service option: %w", sdk.ErrInvalidInput)
        }
        opt(&cfg)
    }
    return &Service{store: store, ids: cfg.ids}, nil
}

// Create persists a new {{.Agg}}, minting its id with the configured generator.
func (s *Service) Create(ctx context.Context, name string) ({{.AggTitle}}, error) {
    entity, err := New(s.ids, name, time.Now())
    if err != nil {
        return {{.AggTitle}}{}, err
    }
    return s.store.Create(ctx, entity)
}

// Get returns the {{.Agg}} for id, or sdk.ErrNotFound.
func (s *Service) Get(ctx context.Context, id string) ({{.AggTitle}}, error) {
    return s.store.Get(ctx, id)
}

// Delete removes the {{.Agg}} for id. An absent id succeeds.
func (s *Service) Delete(ctx context.Context, id string) error {
    return s.store.Delete(ctx, id)
}

// List returns a cursor-paginated page matching filter.
func (s *Service) List(ctx context.Context, filter ListFilter, req list.Request) (list.Page[{{.AggTitle}}], error) {
    return s.store.List(ctx, filter, req)
}
