# {{.ModulePath}} — environment template. Copy to .env and fill in.
# All values here are non-secret placeholders; never commit real credentials.
# An empty value (KEY=) or a commented-out key keeps the default.
# Quote a value that contains " #" — an unquoted " #" starts a comment.

# --- Runtime mode ---
# APP_RUNTIME_MODE=development|production — read from the process environment only, never from this file (LoadEnvForMode refuses any assignment of the key in .env); development: APP_RUNTIME_MODE=development make run; production: systemd Environment=/EnvironmentFile=, docker --env-file, or platform secrets

# --- HTTP server ---
HOST=localhost
PORT={{.Port}}
# Optional; the sdk defaults are 15s read, 15s write, 120s idle.
READ_TIMEOUT=
WRITE_TIMEOUT=
IDLE_TIMEOUT=
SHUTDOWN_TIMEOUT=10s
# Reverse proxies in front of this server; 0 trusts only the peer address.
TRUSTED_PROXY_COUNT=0
# The externally visible origin (https://… in production, where it is required).
PUBLIC_BASE_URL=

# --- Logging ---
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# STDERR | STDOUT
LOG_OUTPUT=STDERR
# Extra attribute keys to redact, comma-separated; adds to the defaults (password, token, api_key, ...), e.g. client_ip,user_agent.
# LOG_REDACT_KEYS=
{{- if eq .DB "turso"}}

# --- Datastore (Turso / libSQL) ---
# libsql://... for a remote database, or file:///abs/path.db for a local one.
TURSO_DATABASE_URL=
# Required for a remote Turso URL; leave empty for file:// DSNs.
TURSO_AUTH_TOKEN=
{{- end}}
{{- if eq .DB "pgx"}}

# --- Datastore (PostgreSQL / pgx) ---
# PostgreSQL 18 or later: the migration runner refuses an older server.
# Set DB_URL for a full DSN, or the split fields below (one or the other).
# postgres://user:pass@host:5432/db?sslmode=verify-full&sslrootcert=system
DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=verify-full
# DB_SSLMODE=disable  # local docker only — refused in production
# Statement and lock timeouts: server process only — the migrator zeroes them.
# DB_STATEMENT_TIMEOUT=30s
# DB_LOCK_TIMEOUT=5s
# Query logging (SQL, argument count and types; _ARGS adds bind values): development only; production refuses.
# DB_LOG_QUERIES=true
# DB_LOG_QUERY_ARGS=true
{{- end}}
