	store "github.com/gopernicus/gopernicus/pockets/authorization/stores/pgx"
	tursostore "github.com/gopernicus/gopernicus/pockets/authorization/stores/turso"
)

type command struct {
	ID       int
	Op       string
	Workload string
}
type response struct {
	Benchmark    *benchmarkResult
	ID           int
	PID          int
	Allowed      bool
	Error        string
	Stats        decisions.CacheStats
	Snapshots    uint64
	Observations uint64
	Results      []bool
}

func schema() relationships.Schema {
	return relationships.NewSchema([]relationships.ResourceSchema{
		{Name: "workspace", Def: relationships.ResourceTypeDef{Relations: map[string]relationships.RelationDef{"viewer": {AllowedSubjects: []relationships.SubjectTypeRef{{Type: "user"}}}}, Permissions: map[string]relationships.PermissionRule{"view": relationships.AnyOf(relationships.Direct("viewer"))}}},
		{Name: "document", Def: relationships.ResourceTypeDef{Relations: map[string]relationships.RelationDef{"viewer": {AllowedSubjects: []relationships.SubjectTypeRef{{Type: "user"}}}, "workspace": {AllowedSubjects: []relationships.SubjectTypeRef{{Type: "workspace"}}}}, Permissions: map[string]relationships.PermissionRule{"view": relationships.AnyOf(relationships.Direct("viewer"), relationships.Through("workspace", "view"))}}},
	})
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() error {
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()
	var repos authorization.Repositories
	var err error
	migrate := len(os.Args) == 2 && os.Args[1] == "migrate"
	migrateCache := len(os.Args) == 2 && os.Args[1] == "migrate-cache"
	cacheMode := os.Getenv("FIXTURE_CACHE")
	switch os.Getenv("FIXTURE_BACKEND") {
	case "firestore":
		if os.Getenv("FIRESTORE_EMULATOR_HOST") == "" {
			return errors.New("Firestore fixture requires owned emulator")
		}
		db, openErr := firestoredb.Open(context.Background(), firestoredb.Config{ProjectID: os.Getenv("FIRESTORE_PROJECT_ID"), DatabaseID: os.Getenv("FIXTURE_FIRESTORE_DATABASE")})
		if openErr != nil {
			return openErr
		}
		defer db.Close()
		if migrate {
			return nil
		}
		if migrateCache {
			return firestorestore.InitializeCacheInvalidation(ctx, db)
		}
		options := []firestorestore.Option{firestorestore.WithoutIndexProbe()}
		if cacheMode != "" {
			options = append(options, firestorestore.WithCacheReads())
		} else if os.Getenv("FIXTURE_FS_PARTICIPATE") == "1" {
			options = append(options, firestorestore.WithCacheInvalidation())
		}
		repos, err = firestorestore.Repositories(ctx, db, options...)
	case "pgx":
		db, openErr := pgxdb.Open(ctx, pgxdb.Config{DSN: os.Getenv("FIXTURE_DSN")})
		if openErr != nil {
			return openErr
		}
		defer db.Close()
		if migrate {
			return pgxdb.RunMigrations(ctx, db, store.MigrationsFS, store.MigrationsDir)
		}
		if migrateCache {
			data, err := store.CacheMigrationsFS.ReadFile(store.CacheMigrationsDir + "/0001_iam_cache_invalidation.sql")
			if err != nil {
				return err
			}
			return db.InTx(ctx, func(tx *pgxdb.Tx) error { _, err := tx.Exec(ctx, string(data)); return err })
		}
		options := []store.Option{}
		if cacheMode != "" {
			options = append(options, store.WithCacheReads())
		}
		repos, err = store.Repositories(ctx, db, options...)
	case "turso":
		db, openErr := tursodb.Open(ctx, tursodb.Config{URL: os.Getenv("FIXTURE_DSN")})
		if openErr != nil {
			return openErr
		}
		defer db.Close()
		if migrate {
			return tursodb.RunMigrations(ctx, db, tursostore.MigrationsFS, tursostore.MigrationsDir)
		}
		if migrateCache {
			data, err := tursostore.CacheMigrationsFS.ReadFile(tursostore.CacheMigrationsDir + "/0001_iam_cache_invalidation.sql")
			if err != nil {
				return err
			}
			return db.InTx(ctx, func(tx *tursodb.Tx) error { _, err := tx.Exec(ctx, string(data)); return err })
		}
		options := []tursostore.Option{}
		if cacheMode != "" {
			options = append(options, tursostore.WithCacheReads())
		}
		repos, err = tursostore.Repositories(ctx, db, options...)
	default:
		return fmt.Errorf("unsupported fixture backend")
	}
	if err != nil {
		return err
	}
	var source *countedSource
	var bytes *faultCache
	options := []authorization.Option{authorization.WithRelationshipModel(schema()), authorization.WithRoleModel(model.RoleModel{ResourceTypes: map[string]model.RoleTypeDef{"document": {Roles: []string{"auditor"}, Permissions: map[string][]string{"audit": {"auditor"}}}}})}
	if cacheMode != "" {
		source = &countedSource{CacheSource: repos.CacheSource}
		repos.CacheSource = source
		var backend cacher.Storer
		switch cacheMode {
		case "lru":
			backend = cacher.NewMemory()
		case "redis":
			client := redis.NewClient(&redis.Options{Addr: os.Getenv("FIXTURE_REDIS"), DialTimeout: time.Second, ReadTimeout: time.Second, WriteTimeout: time.Second})
			defer client.Close()
			backend = goredis.NewCacher(client)
		default:
			return fmt.Errorf("unsupported byte cache %q", cacheMode)
		}
		bytes = &faultCache{Storer: backend}
		options = append(options, authorization.WithCacher(bytes, decisions.CachePolicy{Namespace: os.Getenv("FIXTURE_NAMESPACE"), MaxStaleness: fixtureStaleness, PollInterval: 100 * time.Millisecond, PollTimeout: 200 * time.Millisecond, CacheTimeout: 100 * time.Millisecond}))
	}
	components, err := authorization.New(repos, options...)
	if err != nil {
		return err
	}
	if components.ReadCache != nil {
		defer components.ReadCache.Close()
	}
	request := model.CheckRequest{Principal: model.PrincipalRef{Type: "user", ID: "fixture-user"}, Resource: model.Resource{Type: "document", ID: "fixture-document"}, Permission: "view"}
	scanner := bufio.NewScanner(os.Stdin)
	scanner.Buffer(make([]byte, 1024), 4096)
	out := json.NewEncoder(os.Stdout)
	for scanner.Scan() {
		var cmd command
		if err := json.Unmarshal(scanner.Bytes(), &cmd); err != nil {
			return err
		}
		res := response{ID: cmd.ID, PID: os.Getpid()}
		timeout := 10 * time.Second
		if strings.HasPrefix(cmd.Op, "benchmark_") {
			timeout = 60 * time.Second
		}
		ctx, cancel := context.WithTimeout(context.Background(), timeout)
		var err error
		switch cmd.Op {
		case "benchmark_setup":
			tuples := []relationships.CreateRelationship{{ResourceType: "document", ResourceID: "through-document", Relation: "workspace", SubjectType: "workspace", SubjectID: "fixture-workspace"}, {ResourceType: "workspace", ResourceID: "fixture-workspace", Relation: "viewer", SubjectType: "user", SubjectID: "fixture-user"}}
			for i := 0; i < 500; i++ {
				tuples = append(tuples, relationships.CreateRelationship{ResourceType: "document", ResourceID: fmt.Sprintf("benchmark-document-%d", i), Relation: "viewer", SubjectType: "user", SubjectID: "fixture-user"})
			}
			for offset := 0; offset < len(tuples); offset += 40 {
				if err = components.RelationshipWriter.CreateRelationships(ctx, tuples[offset:min(offset+40, len(tuples))]); err != nil {
					break
				}
			}
		case "benchmark_check":
			var workerDone chan struct{}
			var stopWorker context.CancelFunc
			if components.ReadCache != nil && components.ReadCache.Stats().Ready {
				var workerCtx context.Context
				workerCtx, stopWorker = context.WithCancel(ctx)
				workerDone = make(chan struct{})
				go func() {
					defer close(workerDone)
					ticker := time.NewTicker(components.ReadCache.PollInterval())
					defer ticker.Stop()
					for {
						select {
						case <-workerCtx.Done():
							return
						case <-ticker.C:
							_ = components.ReadCache.Poll(workerCtx)
						}
					}
				}()
			}
			operation := func(ctx context.Context, index int) error {
				req := request
				switch cmd.Workload {
				case "deny":
					req.Principal.ID = "absent-user"
				case "through":
					req.Resource.ID = "through-document"
				case "role":
					req.Permission = "audit"
				case "explain":
					result, _, err := components.Decisions.CheckExplain(ctx, req)
					if err != nil {
						return err
					}
					if !result.Allowed {
						return errors.New("explain denied")
					}
					return nil
				case "filter":
					ids := make([]string, 100)
					for i := range ids {
						ids[i] = fmt.Sprintf("benchmark-document-%d", i)
					}
					result, err := components.Decisions.FilterAuthorized(ctx, req.Principal, "view", "document", ids)
					if err != nil {
						return err
					}
					if len(result) != 100 {
						return errors.New("filter mismatch")
					}
					return nil
				case "partial":
					requests := []model.CheckRequest{req, req}
					requests[1].Resource.ID = fmt.Sprintf("partial-%d-%d-%d", os.Getpid(), cmd.ID, index)
					result, err := components.Decisions.CheckBatch(ctx, requests)
					if err != nil {
						return err
					}
					if len(result) != 2 || !result[0].Allowed || result[1].Allowed {
						return errors.New("partial mismatch")
					}
					return nil
				}
				if strings.HasPrefix(cmd.Workload, "batch") {
					size, parseErr := strconv.Atoi(strings.TrimSuffix(strings.TrimPrefix(cmd.Workload, "batch"), "mixed"))
					if parseErr != nil {
						return parseErr
					}
					requests := make([]model.CheckRequest, size)
					for i := range requests {
						requests[i] = req
						requests[i].Resource.ID = fmt.Sprintf("benchmark-document-%d", i)
						if strings.HasSuffix(cmd.Workload, "mixed") && i%2 == 1 {
							requests[i].Permission = "audit"
							requests[i].Resource.ID = "fixture-document"
						}
					}
					result, err := components.Decisions.CheckBatch(ctx, requests)
					if err != nil {
						return err
					}
					if len(result) != size {
						return errors.New("batch length mismatch")
					}
					for _, item := range result {
						if !item.Allowed {
							return errors.New("batch denied")
						}
					}
					return nil
				}
				result, err := components.Decisions.Check(ctx, req)
				if err != nil {
					return err
				}
				if result.Allowed == (cmd.Workload == "deny") {
					return errors.New("check mismatch")
				}
				return nil
			}
			if cmd.Workload == "outage" && bytes != nil {
				bytes.fail.Store(true)
			}
			for i := 0; i < 5; i++ {
				if err = operation(ctx, -i-1); err != nil {
					break
				}
			}
			var before decisions.CacheStats
			if components.ReadCache != nil {
				before = components.ReadCache.Stats()
			}
			count, interval := 60, 20*time.Millisecond
			if strings.Contains(cmd.Workload, "100") || strings.Contains(cmd.Workload, "500") {
				count, interval = 30, 50*time.Millisecond
			}
			if err == nil {
				res.Benchmark, err = runBenchmark(ctx, count, interval, operation)
			}
			if res.Benchmark != nil && components.ReadCache != nil {
				after := components.ReadCache.Stats()
				res.Benchmark.Hits = after.HitComplete - before.HitComplete
				res.Benchmark.Fallbacks = after.MissFallback - before.MissFallback
				res.Benchmark.Bypasses = after.BypassCold - before.BypassCold + after.BypassExpired - before.BypassExpired
				res.Benchmark.CacheErrors = after.CacheErrors - before.CacheErrors
			}
			if bytes != nil {
				bytes.fail.Store(false)
			}

			if stopWorker != nil {
				stopWorker()
				<-workerDone
			}
		case "benchmark_write":
			res.Benchmark, err = runBenchmark(ctx, 100, 20*time.Millisecond, func(ctx context.Context, index int) error {
				return components.RelationshipWriter.SetRelationTargets(ctx, model.Resource{Type: "document", ID: fmt.Sprintf("benchmark-process-%d", os.Getpid())}, "viewer", []relationships.SubjectRef{{Type: "user", ID: fmt.Sprintf("subject-%d", index)}})
			})
		case "barrier", "stats":
		case "poll":
			if components.ReadCache == nil {
				err = errors.New("no cache runtime")
			} else {
				err = components.ReadCache.Poll(ctx)
			}
		case "cache_fail", "cache_recover":
			if bytes == nil {
				err = errors.New("no byte cache")
			} else {
				bytes.fail.Store(cmd.Op == "cache_fail")
			}
		case "await_expiry":
			timer := time.NewTimer(fixtureStaleness + 100*time.Millisecond)
			select {
			case <-timer.C:
			case <-ctx.Done():
				err = ctx.Err()
			}
			timer.Stop()
		case "check_batch":
			requests := []model.CheckRequest{request, request, request}
			requests[1].Resource.ID = "absent-document"
			requests[2].Permission = "audit"
			var results []model.CheckResult
			results, err = components.Decisions.CheckBatch(ctx, requests)
			for _, result := range results {
				res.Results = append(res.Results, result.Allowed)
			}
		case "explain":
			var result model.CheckResult
			result, _, err = components.Decisions.CheckExplain(ctx, request)
			res.Allowed = result.Allowed
		case "grant", "revoke":
			targets := []relationships.SubjectRef{}
			if cmd.Op == "grant" {
				targets = append(targets, relationships.SubjectRef{Type: "user", ID: "fixture-user"})
			}
			err = components.RelationshipWriter.SetRelationTargets(ctx, model.Resource{Type: "document", ID: "fixture-document"}, "viewer", targets)
			if err == nil {
				if cmd.Op == "grant" {
					err = repos.Roles.Assign(ctx, roles.Assignment{SubjectType: "user", SubjectID: "fixture-user", Role: "auditor", ResourceType: "document", ResourceID: "fixture-document"})
				} else {
					err = repos.Roles.Unassign(ctx, "user", "fixture-user", "auditor", "document", "fixture-document")
				}
			}
		case "check":
			var result model.CheckResult
			result, err = components.Decisions.Check(ctx, request)
			res.Allowed = result.Allowed
		default:
			err = fmt.Errorf("unsupported control operation %q", cmd.Op)
		}
		if components.ReadCache != nil {
			res.Stats = components.ReadCache.Stats()
		}
		if source != nil {
			res.Snapshots, res.Observations = source.snapshots.Load(), source.observations.Load()
		}
		cancel()
		if err != nil {
			res.Error = err.Error()
		}
		if err := out.Encode(res); err != nil {
			return err
		}
	}
	return scanner.Err()
}

const fixtureStaleness = 2 * time.Second

type countedSource struct {
	decisions.CacheSource
	snapshots    atomic.Uint64
	observations atomic.Uint64
}

func (s *countedSource) Observe(ctx context.Context) (decisions.CacheVersion, error) {
	s.observations.Add(1)
	return s.CacheSource.Observe(ctx)
}
func (s *countedSource) ReadSnapshot(ctx context.Context, fn func(context.Context, decisions.CacheVersion, decisions.CheckReads) error) error {
	s.snapshots.Add(1)
	return s.CacheSource.ReadSnapshot(ctx, fn)
}

type faultCache struct {
	cacher.Storer
	fail  atomic.Bool
	calls atomic.Uint64
}

func (c *faultCache) Get(ctx context.Context, key string) ([]byte, bool, error) {
	c.calls.Add(1)
	if c.fail.Load() {
		return nil, false, errors.New("injected byte-cache outage")
	}
	return c.Storer.Get(ctx, key)
}
func (c *faultCache) GetMany(ctx context.Context, keys []string) (map[string][]byte, error) {
	c.calls.Add(1)
	if c.fail.Load() {
		return nil, errors.New("injected byte-cache outage")
	}
	return c.Storer.GetMany(ctx, keys)
}
func (c *faultCache) Set(ctx context.Context, key string, value []byte, ttl time.Duration) error {
	c.calls.Add(1)
	if c.fail.Load() {
		return errors.New("injected byte-cache outage")
	}
	return c.Storer.Set(ctx, key, value, ttl)
}

// Fixed-rate arrivals record scheduling delay as well as service latency; requests
// are not paced by the previous request's completion.
type benchmarkResult struct {
	Errors           map[string]int
	SamplesNS        []int64
	Hits             uint64
	Fallbacks        uint64
	Bypasses         uint64
	CacheErrors      uint64
	Count            int
	OfferedPerSecond float64
	P50NS            int64
	P95NS            int64
	P99NS            int64
	MaxArrivalLagNS  int64
}

func runBenchmark(ctx context.Context, count int, interval time.Duration, operation func(context.Context, int) error) (*benchmarkResult, error) {
	durations := make([]int64, count)
	lags := make([]int64, count)
	failures := make(chan error, count)
	var workers sync.WaitGroup
	start := time.Now()
	for i := 0; i < count; i++ {
		scheduled := start.Add(time.Duration(i) * interval)
		timer := time.NewTimer(max(0, time.Until(scheduled)))
		select {
		case <-ctx.Done():
			timer.Stop()
			workers.Wait()
			return nil, ctx.Err()
		case <-timer.C:
		}
		workers.Add(1)
		go func(index int, scheduled time.Time) {
			defer workers.Done()
			began := time.Now()
			lags[index] = began.Sub(scheduled).Nanoseconds()
			if err := operation(ctx, index); err != nil {
				failures <- err
			}
			durations[index] = time.Since(scheduled).Nanoseconds()
		}(i, scheduled)
	}
	workers.Wait()
	close(failures)
	errorCounts := map[string]int{}
	for err := range failures {
		errorCounts[err.Error()]++
	}
	slices.Sort(durations)
	return &benchmarkResult{Errors: errorCounts, Count: count, OfferedPerSecond: float64(time.Second) / float64(interval), P50NS: durations[(count*50+99)/100-1], P95NS: durations[(count*95+99)/100-1], P99NS: durations[(count*99+99)/100-1], SamplesNS: durations, MaxArrivalLagNS: slices.Max(lags)}, nil
}
