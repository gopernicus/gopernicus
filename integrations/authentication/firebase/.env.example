# integrations/authentication/firebase — placeholders only. Never commit a key.
#
# Production: Application Default Credentials (an attached, least-privilege
# service account) need no variable beyond the project id.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Off GCP only: a dedicated service-account key (never firebase-adminsdk-*).
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-auth-reader.json

# Local development ONLY (make dev-firebase). Production construction refuses it.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-gopernicus

# Live leg (-tags=live): a fresh ID token from the project above.
# FIREBASE_LIVE_ID_TOKEN=
# FIREBASE_LIVE_REVOKE=1
